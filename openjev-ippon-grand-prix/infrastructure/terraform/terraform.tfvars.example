# Terraform itself has no --profile flag; invoke it with AWS_PROFILE=yuta.
project_name = "openjev-ippon-grand-prix"
environment  = "poc"

# Keep MicroVM while validating the OpenRouter implementation. Switch to
# "openrouter" after storing the API key in the secret below.
judging_provider = "microvm"
openrouter_model = "typesafe/jev-1.13"
# Optional. Empty uses "<project>-<environment>/openrouter/api-key".
# openrouter_api_key_secret_name = "openjev-ippon-grand-prix-poc/openrouter/api-key"

# First apply infrastructure/publisher, start its CodeBuild release, then copy
# PUBLISHED_ARTIFACT_BUCKET and PUBLISHED_ARTIFACT_KEY from the build logs.
artifact_bucket_name  = "REPLACE_WITH_PUBLISHER_OUTPUT"
microvm_artifact_key  = "microvm/published/REPLACE_WITH_40_HEX_MODEL_REVISION/REPLACE_WITH_64_HEX_ZIP_SHA256/openjev-runtime.zip"

# Obtain this immutable value with an AWS CLI version that supports Lambda MicroVMs:
# aws lambda-microvms list-managed-microvm-image-versions \
#   --image-identifier arn:aws:lambda:ap-northeast-1:aws:microvm-image:al2023-1 \
#   --region ap-northeast-1 --profile yuta
microvm_base_image_version = "REPLACE_WITH_AVAILABLE_VERSION"

# The two Lambda ZIPs are still uploaded from these local paths during the
# application deployment. The MicroVM ZIP is exclusively published by CodeBuild.
controller_lambda_artifact_key      = "lambda/controller.zip"
streaming_proxy_lambda_artifact_key = "lambda/streaming-proxy.zip"

# npm run build in apps/frontend produces this directory, which Terraform
# uploads to the CloudFront origin on every apply.
frontend_dist_path = "../../apps/frontend/dist"

# Qwen3-0.6B Q4_K_M is packaged into the image. Lambda MicroVMs can burst CPU;
# 4 GiB is the PoC baseline and can be raised after observing RSS.
microvm_minimum_memory_mib = 4096
