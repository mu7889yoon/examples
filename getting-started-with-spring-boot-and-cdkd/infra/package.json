{
  "name": "todo-infrastructure",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --runInBand",
    "bootstrap": "AWS_REGION=ap-northeast-1 cdkd bootstrap",
    "synth": "AWS_REGION=ap-northeast-1 ./scripts/cdkd-existing.sh synth TodoAppStack --profile yuta --region ap-northeast-1",
    "diff": "AWS_REGION=ap-northeast-1 ./scripts/cdkd-existing.sh diff TodoAppStack --profile yuta --region ap-northeast-1",
    "deploy:dry-run": "AWS_REGION=ap-northeast-1 ./scripts/cdkd-existing.sh deploy TodoAppStack --dry-run --profile yuta --region ap-northeast-1",
    "deploy": "AWS_REGION=ap-northeast-1 ./scripts/cdkd-existing.sh deploy TodoAppStack --full-wait --profile yuta --region ap-northeast-1",
    "destroy": "AWS_REGION=ap-northeast-1 ./scripts/cdkd-existing.sh destroy TodoAppStack --profile yuta --region ap-northeast-1",
    "synth:fresh": "AWS_REGION=ap-northeast-1 cdkd synth TodoStack",
    "deploy:fresh": "AWS_REGION=ap-northeast-1 cdkd deploy TodoStack --full-wait --profile yuta --region ap-northeast-1"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@go-to-k/cdkd": "0.294.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
